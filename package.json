{
  "name": "dev-productivity",
  "version": "1.0.0",
  "description": "A professional developer productivity dashboard that tracks key performance metrics, provides team comparisons, and offers actionable insights for engineering teams.",
  "private": false,
  "homepage": "https://github.com/your-org/dev-productivity#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/dev-productivity.git"
  },
  "keywords": [
    "react",
    "dashboard",
    "productivity",
    "metrics",
    "analytics",
    "developer-tools",
    "team-management"
  ],
  "author": "DevMetrics Team",
  "license": "MIT",
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.16.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-scripts": "5.0.1",
    "recharts": "^3.8.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write src/**/*.{js,jsx,ts,tsx,css,md}",
    "precommit": "npm run lint && npm run test",
    "analyze": "npm run build && npx bundle-analyzer build/static/js/*.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "bundle-analyzer": "^0.9.0"
  }
}
